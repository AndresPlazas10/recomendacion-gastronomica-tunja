# ===== API (services/api/.env) =====
ENV=development
SUPABASE_URL=https://<proyecto-dev>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # solo backend, nunca en el cliente
DATABASE_URL=postgresql://postgres:<password>@db.<proyecto-dev>.supabase.co:5432/postgres

# ===== App móvil (EXPO_PUBLIC_* son públicas) =====
EXPO_PUBLIC_SUPABASE_URL=https://<proyecto-dev>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
EXPO_PUBLIC_API_URL=http://localhost:8000
